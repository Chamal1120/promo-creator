# promo-creator API keys. Copy this file to .env (same folder) and fill in the keys you have:
#   cp .env.example .env
# .env is gitignored. Never commit it or paste keys into chat. Both keys are optional:
# without them the studio uses free local tools (local TTS, no AI music).

# ElevenLabs: voiceover (TTS), sound effects, music. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Google Gemini: Gemini TTS voiceover and Lyria music. https://aistudio.google.com/apikey
GEMINI_API_KEY=
