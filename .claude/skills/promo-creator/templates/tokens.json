{
  "color": {
    "bg": "#0B0D12",
    "surface": "#151925",
    "text": "#F4F5F7",
    "muted": "#8A90A2",
    "accent": "#5B8CFF",
    "accent2": "#3DDC97"
  },
  "font": {
    "display": { "family": "Inter", "weight": 800, "file": "fonts/Inter-ExtraBold.woff2" },
    "body": { "family": "Inter", "weight": 500, "file": "fonts/Inter-Medium.woff2" },
    "mono": { "family": "JetBrains Mono", "weight": 500, "file": "fonts/JetBrainsMono-Medium.woff2" }
  },
  "type_scale_px": { "hero": 140, "h1": 96, "h2": 64, "body": 40, "caption": 32 },
  "space_px": { "safe_margin": 96, "gap": 32 },
  "radius_px": 24,
  "motion": {
    "easing": {
      "enter": { "gsap": "power3.out", "remotion": "Easing.out(Easing.cubic)" },
      "exit": { "gsap": "power2.in", "remotion": "Easing.in(Easing.quad)" },
      "emphasis": { "gsap": "expo.out", "remotion": "Easing.out(Easing.exp)" }
    },
    "duration_s": { "fast": 0.3, "base": 0.6, "slow": 1.0 },
    "stagger_s": 0.08
  }
}
